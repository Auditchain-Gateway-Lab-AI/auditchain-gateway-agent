{
    "swagger": "2.0",
    "info": {
        "description": "API AuditChain Agent untuk verifikasi integritas data operasional (Lapis 3), pemulihan data (recovery), dan audit independen terhadap blockchain.",
        "title": "AuditChain Agent API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Tim AuditChain",
            "url": "https://auditchain.id",
            "email": "support@auditchain.id"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:9090",
    "basePath": "/",
    "paths": {
        "/audit/health": {
            "get": {
                "description": "Mengecek status kesiapan modul audit.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Health check modul audit",
                "responses": {
                    "200": {
                        "description": "Modul audit ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/audit/resource/{resource}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mengaudit integritas satu resource spesifik (format TABLE:ID atau TABLE/ID) terhadap log offchain dan blockchain.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Audit satu resource spesifik",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Resource yang diaudit (contoh: KABUPATEN:3201 atau KABUPATEN/3201)",
                        "name": "resource",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Otomatis pulihkan data jika tampered",
                        "name": "auto_recover",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hasil audit satu resource",
                        "schema": {
                            "$ref": "#/definitions/audit.LogResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/audit/run": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Memicu proses audit integritas data: mengambil offchain log dari Gateway, membandingkan hash dengan data aktual di database Oracle klien, dan memverifikasi Merkle Root di blockchain via Gateway. Hasilnya otomatis dilaporkan ke Gateway untuk memperbarui statistik dashboard.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Jalankan audit integritas data",
                "parameters": [
                    {
                        "description": "Parameter audit waktu atau resource (hanya untuk POST)",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/audit.AuditRunRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Waktu awal audit (format RFC3339, e.g. 2026-10-19T00:00:00Z)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Waktu akhir audit (format RFC3339, e.g. 2026-10-20T00:00:00Z)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter resource spesifik (format TABLE:ID)",
                        "name": "resource",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Otomatis pulihkan data jika ditemukan anomali/tamper",
                        "name": "auto_recover",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Laporan hasil audit",
                        "schema": {
                            "$ref": "#/definitions/audit.Report"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Memicu proses audit integritas data: mengambil offchain log dari Gateway, membandingkan hash dengan data aktual di database Oracle klien, dan memverifikasi Merkle Root di blockchain via Gateway. Hasilnya otomatis dilaporkan ke Gateway untuk memperbarui statistik dashboard.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Jalankan audit integritas data",
                "parameters": [
                    {
                        "description": "Parameter audit waktu atau resource (hanya untuk POST)",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/audit.AuditRunRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Waktu awal audit (format RFC3339, e.g. 2026-10-19T00:00:00Z)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Waktu akhir audit (format RFC3339, e.g. 2026-10-20T00:00:00Z)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter resource spesifik (format TABLE:ID)",
                        "name": "resource",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Otomatis pulihkan data jika ditemukan anomali/tamper",
                        "name": "auto_recover",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Laporan hasil audit",
                        "schema": {
                            "$ref": "#/definitions/audit.Report"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Mengecek status kesehatan dasar aplikasi Agent.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check agent",
                "responses": {
                    "200": {
                        "description": "Status agent sehat",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Mengecek kesiapan Agent dan konektivitas ke database Oracle.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Readiness check agent",
                "responses": {
                    "200": {
                        "description": "Agent siap menerima koneksi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Database tidak dapat dihubungi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/recover": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Melakukan pemulihan (rollback/update) satu baris data operasional di database Oracle klien menggunakan payload data bersih dari blockchain/offchain log.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Recovery"
                ],
                "summary": "Pemulihan data satu baris (Single-row Recovery)",
                "parameters": [
                    {
                        "description": "Detail baris dan data bersih yang akan dipulihkan",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/recovery.RecoverRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hasil pemulihan data",
                        "schema": {
                            "$ref": "#/definitions/recovery.RecoverResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Gagal memulihkan baris",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Recovery service disabled",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/table/{table}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Membaca daftar record dari tabel operasional secara bulk (hanya aktif jika AGENT_ENABLE_TABLE_ENDPOINT=true).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verify"
                ],
                "summary": "Ambil data tabel secara bulk (jika diaktifkan)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nama tabel",
                        "name": "table",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data tabel",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found / Endpoint Disabled",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/verify-audit-lookup": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mencari histori perubahan data dari tabel audit_trail dengan filter tabel, record_id, rentang waktu, dan pagination.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verify"
                ],
                "summary": "Cari rekaman audit trail historis",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nama tabel",
                        "name": "table",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "ID baris record",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Operasi (INSERT, UPDATE, DELETE)",
                        "name": "operation",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Timestamp referensi (RFC3339)",
                        "name": "at",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Batas awal waktu (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Batas akhir waktu (RFC3339)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Batas jumlah record (default 50, max 200)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Offset pagination",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Daftar rekaman audit trail",
                        "schema": {
                            "$ref": "#/definitions/verify.AuditTrailLookupResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/verify-audit/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mengambil satu record historis dari tabel audit_trail berdasarkan ID audit_trail.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verify"
                ],
                "summary": "Ambil satu rekaman audit trail historis",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID baris audit trail",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Rekaman audit trail historis",
                        "schema": {
                            "$ref": "#/definitions/verify.AuditTrailRecord"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/verify/{table}/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Membaca baris data terkini langsung dari tabel operasional Oracle berdasarkan tabel dan ID primary key.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verify"
                ],
                "summary": "Ambil data operasional terkini (Lapis 3)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nama tabel operasional (contoh: KABUPATEN)",
                        "name": "table",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Nilai primary key / ID baris",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data baris operasional terkini",
                        "schema": {
                            "$ref": "#/definitions/verify.ResourceRecord"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "audit.AuditRunRequest": {
            "type": "object",
            "properties": {
                "auto_recover": {
                    "description": "If true and data is tampered, trigger recovery",
                    "type": "boolean"
                },
                "from": {
                    "description": "RFC3339 timestamp",
                    "type": "string"
                },
                "resource": {
                    "description": "Optional: filter by single resource TABLE:ID",
                    "type": "string"
                },
                "to": {
                    "description": "RFC3339 timestamp",
                    "type": "string"
                }
            }
        },
        "audit.Discrepancy": {
            "type": "object",
            "properties": {
                "actual": {},
                "expected": {},
                "field": {
                    "type": "string"
                }
            }
        },
        "audit.LogResult": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "auto_recovered": {
                    "type": "boolean"
                },
                "blockchain_status": {
                    "description": "VALID | TAMPERED | PENDING | SKIPPED | ERROR",
                    "type": "string"
                },
                "blockchain_tx_id": {
                    "type": "string"
                },
                "client_hash": {
                    "type": "string"
                },
                "data_status": {
                    "description": "VALID | TAMPERED | NOT_FOUND | ERROR",
                    "type": "string"
                },
                "discrepancies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/audit.Discrepancy"
                    }
                },
                "error": {
                    "type": "string"
                },
                "log_id": {
                    "type": "string"
                },
                "merkle_root": {
                    "type": "string"
                },
                "offchain_hash": {
                    "type": "string"
                },
                "recovery_error": {
                    "type": "string"
                },
                "resource": {
                    "type": "string"
                }
            }
        },
        "audit.Report": {
            "type": "object",
            "properties": {
                "audited_logs": {
                    "type": "integer"
                },
                "auto_recovered_count": {
                    "type": "integer"
                },
                "blockchain_error": {
                    "type": "integer"
                },
                "blockchain_pending": {
                    "type": "integer"
                },
                "blockchain_skipped": {
                    "type": "integer"
                },
                "blockchain_tampered": {
                    "type": "integer"
                },
                "blockchain_valid": {
                    "type": "integer"
                },
                "data_error": {
                    "type": "integer"
                },
                "data_not_found": {
                    "type": "integer"
                },
                "data_tampered": {
                    "type": "integer"
                },
                "data_valid": {
                    "type": "integer"
                },
                "duration": {
                    "type": "string"
                },
                "from": {
                    "type": "string"
                },
                "historical_skipped": {
                    "type": "integer"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/audit.LogResult"
                    }
                },
                "run_id": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "total_logs": {
                    "type": "integer"
                }
            }
        },
        "recovery.RecoverRequest": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "Clean column-value map",
                    "type": "object",
                    "additionalProperties": true
                },
                "id": {
                    "description": "e.g. \"3201\"",
                    "type": "string"
                },
                "resource": {
                    "description": "e.g. \"KABUPATEN:3201\"",
                    "type": "string"
                },
                "table": {
                    "description": "e.g. \"KABUPATEN\"",
                    "type": "string"
                }
            }
        },
        "recovery.RecoverResult": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "e.g. \"3201\"",
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "operation": {
                    "description": "\"UPDATE\" | \"INSERT\"",
                    "type": "string"
                },
                "recovered_columns": {
                    "description": "list of updated columns",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "status": {
                    "description": "\"SUCCESS\" | \"FAILED\"",
                    "type": "string"
                },
                "table": {
                    "description": "e.g. \"KABUPATEN\"",
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "verify.AuditTrailLookupResult": {
            "type": "object",
            "properties": {
                "records": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/verify.AuditTrailRecord"
                    }
                },
                "truncated": {
                    "type": "boolean"
                }
            }
        },
        "verify.AuditTrailRecord": {
            "type": "object",
            "properties": {
                "app_user": {
                    "type": "string"
                },
                "data_baru": {
                    "type": "object",
                    "additionalProperties": true
                },
                "data_lama": {
                    "type": "object",
                    "additionalProperties": true
                },
                "db_user": {
                    "type": "string"
                },
                "found": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "operasi": {
                    "type": "string"
                },
                "tabel": {
                    "type": "string"
                },
                "waktu": {
                    "type": "string"
                }
            }
        },
        "verify.ResourceRecord": {
            "type": "object",
            "properties": {
                "checked_at": {
                    "type": "string"
                },
                "data": {
                    "type": "object",
                    "additionalProperties": true
                },
                "found": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "table": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Masukkan token otentikasi dengan format: Bearer \u003ctoken\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}