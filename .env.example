# Database connection (do not commit real credentials)
DB_HOST=127.0.0.1
DB_PORT=1521
DB_USER=client_user
DB_PASSWORD=change-me
DB_NAME=ORCLCDB

# Read-only verify authentication
AGENT_VERIFY_TOKEN=replace-with-a-long-read-token
AGENT_VERIFY_PORT=9090

# The safe default is disabled. Enable only after policy and staging sign-off.
AGENT_RECOVERY_ENABLED=false
AGENT_CLIENT_ID=
AGENT_RECOVERY_TOKEN=
AGENT_RECOVERY_STATE_PATH=/var/lib/auditchain-agent/recovery-state.db
AGENT_RECOVERY_MAX_BODY_BYTES=1048576
AGENT_RECOVERY_MAX_COLUMNS=64
AGENT_RECOVERY_MAX_CLOCK_SKEW_SECONDS=300
AGENT_RECOVERY_REQUEST_TIMEOUT_SECONDS=15
AGENT_RECOVERY_RETENTION_DAYS=90
AGENT_RECOVERY_POLICY_PATH=/app/recovery-policy.yml

# Disabled by default because this endpoint can enumerate rows.
AGENT_ENABLE_TABLE_ENDPOINT=false

# Optional read-only audit-module POC. Leave disabled unless the Besu
# PostgreSQL URL uses a SELECT-only role and Fabric read credentials are mounted.
AGENT_AUDIT_MODULE_ENABLED=false
AGENT_AUDIT_CLIENT_ID=
AGENT_AUDIT_POSTGRES_URL=postgres://readonly_user:change-me@besu-host:5432/test_blockchain?sslmode=require
AGENT_AUDIT_FABRIC_MSP_ID=
AGENT_AUDIT_FABRIC_PEER_ENDPOINT=
AGENT_AUDIT_FABRIC_TLS_SERVER_NAME=
AGENT_AUDIT_FABRIC_TLS_CERT_PATH=/run/secrets/agent-audit-fabric/ca.crt
AGENT_AUDIT_FABRIC_CERT_PATH=/run/secrets/agent-audit-fabric/client-cert.pem
AGENT_AUDIT_FABRIC_KEY_PATH=/run/secrets/agent-audit-fabric/client-key.pem
AGENT_AUDIT_FABRIC_CHANNEL=
AGENT_AUDIT_FABRIC_CHAINCODE=
