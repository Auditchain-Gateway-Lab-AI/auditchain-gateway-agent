# Copy to .env.connectivity locally. Never commit the filled file.
# Use a PostgreSQL account restricted to SELECT on audit_logs.
CONNECTIVITY_DB_DSN=postgres://READONLY_USER:REPLACE_ME@TAILSCALE_BESU_IP:5433/test_blockchain?sslmode=disable
CONNECTIVITY_CLIENT_ID=REPLACE_WITH_CLIENT_UUID
# Optional. If omitted, the probe selects the newest ANCHORED log for this client.
CONNECTIVITY_ANCHOR_ID=

# Reuse only a Fabric identity allowed to evaluate QueryMerkleRoot.
FABRIC_MSP_ID=REPLACE_WITH_MSP_ID
FABRIC_PEER_ENDPOINT=TAILSCALE_BESU_IP:7051
FABRIC_TLS_CERT_PATH=/run/secrets/fabric-tls-ca.pem
FABRIC_CERT_PATH=/run/secrets/fabric-client-cert.pem
FABRIC_KEY_PATH=/run/secrets/fabric-client-key.pem
FABRIC_CHANNEL=REPLACE_WITH_CHANNEL
FABRIC_CHAINCODE=REPLACE_WITH_CHAINCODE
