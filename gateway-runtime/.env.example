# Gateway runtime only. Do not reuse the Agent's root .env or the read-only
# connectivity-check DSN. Keep the real copy as gateway-runtime/.env (ignored).
PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1
APP_ENV=production

# Use the Gateway runtime database account and the Besu Tailscale address.
# It needs the permissions required by the running Gateway, not a superuser.
DB_DSN=postgres://GATEWAY_RUNTIME_USER:CHANGE_ME@BESU_TAILSCALE_IP:5433/test_blockchain?sslmode=disable
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALLOWED_ORIGINS=http://DASHBOARD_HOST:3001

# The host directory contains ca.crt, probe-cert.pem, and probe-key.pem.
FABRIC_MATERIAL_DIR=/home/morbis1/.config/auditchain/fabric
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=BESU_TAILSCALE_IP:7051
FABRIC_PEER_TLS_SERVER_NAME=peer0.org1.audit.example.com
FABRIC_TLS_CERT_PATH=/run/secrets/fabric/ca.crt
FABRIC_CERT_PATH=/run/secrets/fabric/probe-cert.pem
FABRIC_KEY_PATH=/run/secrets/fabric/probe-key.pem
FABRIC_CHANNEL=audit-channel
FABRIC_CHAINCODE=audit-contract

# Safe preflight: HTTP/API can start, automated Kafka and pipeline workers stay
# off. This is not a whole-application read-only mode. Do not expose the API
# beyond localhost during this preflight.
GATEWAY_BACKGROUND_WORKERS_ENABLED=false
# Set only after checking the existing Kafka consumer-group offsets.
# Required when workers are enabled; valid values are earliest or latest.
KAFKA_CONSUMER_START_OFFSET=

# Direct recovery uses the client Agent; keep disabled until its runtime flow is
# deliberately enabled and tested.
RECOVERY_ENABLED=false
RECOVERY_MODE=agent_direct
RECOVERY_CDC_TIMEOUT_SECONDS=120
SNAPSHOT_WRITER_ENABLED=false
SNAPSHOT_REQUIRED_FOR_ANCHOR=false
VERIFICATION_SCHEDULER_ENABLED=false
TAMPER_SCANNER_ENABLED=false
